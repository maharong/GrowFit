<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F1F1F">

    <!-- 레트로 게임기 프레임 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/deviceFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        android:backgroundTint="#F4E4C6"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <!-- 상단 로고 (Home 과 동일 위치) -->
            <TextView
                android:id="@+id/txtLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GROWFIT"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="#333333"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- LCD 화면 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/lcdScreen"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:backgroundTint="#D0E8D2"
                app:cardCornerRadius="14dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/txtLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/bottomButtonRow">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <!-- 타이틀 -->
                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRESET LIST"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- 빈 상태 표시 -->
                    <TextView
                        android:id="@+id/textEmpty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="프리셋이 존재하지 않습니다.\n아래 + 버튼을 눌러 새 프리셋을 만들어 보세요!"
                        android:textColor="#2B3A30"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@id/txtTitle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:padding="16dp"/>

                    <!-- 리스트 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerPresets"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:overScrollMode="never"
                        android:layout_marginTop="16dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:clipToPadding="false"
                        android:paddingBottom="8dp"
                        app:layout_constraintTop_toBottomOf="@id/txtTitle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ProgressBar
                        android:id="@+id/progressLoading"
                        style="?android:attr/progressBarStyleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- 하단 버튼 영역 -->
            <LinearLayout
                android:id="@+id/bottomButtonRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- SELECT -->
                <ImageButton
                    android:id="@+id/btnSelectPreset"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_round_button_small"
                    android:src="@drawable/ic_check"
                    android:contentDescription="Select preset"
                    app:backgroundTint="#7358C4"
                    app:tint="#FFFFFF" />

                <!-- ADD -->
                <ImageButton
                    android:id="@+id/btnAddPreset"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_round_button_small"
                    android:src="@drawable/ic_add"
                    android:contentDescription="Add preset"
                    app:backgroundTint="#7358C4"
                    app:tint="#FFFFFF" />

                <!-- EDIT -->
                <ImageButton
                    android:id="@+id/btnEditPreset"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_round_button_small"
                    android:src="@drawable/ic_build"
                    android:contentDescription="Edit preset"
                    app:backgroundTint="#7358C4"
                    app:tint="#FFFFFF" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
