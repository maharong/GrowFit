<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F1F1F">

    <!-- 레트로 게임기 프레임 (Home / Preset List와 동일 구조) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/deviceFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        android:backgroundTint="#F4E4C6"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp">

            <!-- 상단 로고 (위치 동일) -->
            <TextView
                android:id="@+id/txtLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GROWFIT"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="#333333"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- LCD 화면 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/lcdScreen"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:backgroundTint="#D0E8D2"
                app:cardCornerRadius="14dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/txtLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/bottomButtonRow">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <!-- 타이틀 -->
                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRESET EDIT"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- 프리셋 이름 라벨 -->
                    <TextView
                        android:id="@+id/textNameLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NAME"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/txtTitle"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <!-- 프리셋 이름 입력 -->
                    <EditText
                        android:id="@+id/editPresetName"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp"
                        android:autofillHints=""
                        android:background="@android:color/transparent"
                        android:fontFamily="monospace"
                        android:inputType="text"
                        android:textColor="#2B3A30"
                        android:textColorHint="#6C8C78"
                        android:hint="Enter preset name"
                        android:padding="4dp"
                        android:singleLine="true"
                        app:layout_constraintTop_toBottomOf="@id/textNameLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- 구분선 느낌의 설명 텍스트 -->
                    <TextView
                        android:id="@+id/textStepHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STEPS"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/editPresetName"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <!-- 빈 상태 표시 (스텝 없을 때) -->
                    <TextView
                        android:id="@+id/textEmptySteps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="스텝이 없습니다.\n아래 + 버튼으로 새 스텝을 추가해 보세요!"
                        android:textColor="#2B3A30"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:visibility="gone"
                        android:padding="12dp"
                        app:layout_constraintTop_toBottomOf="@id/textStepHint"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- 스텝 리스트 -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerSteps"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:overScrollMode="never"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginBottom="4dp"
                        android:clipToPadding="false"
                        android:paddingBottom="8dp"
                        app:layout_constraintTop_toBottomOf="@id/textStepHint"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- 로딩 스피너 (필요하면 사용) -->
                    <ProgressBar
                        android:id="@+id/progressLoading"
                        style="?android:attr/progressBarStyleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- 하단 버튼 영역 (프리셋 리스트와 동일한 스타일) -->
            <LinearLayout
                android:id="@+id/bottomButtonRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- STEP 추가 버튼 -->
                <ImageButton
                    android:id="@+id/btnAddStep"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_round_button_small"
                    android:src="@drawable/ic_add"
                    android:contentDescription="Add step"
                    app:backgroundTint="#7358C4"
                    app:tint="#FFFFFF" />

                <!-- PRESET 저장 버튼 -->
                <ImageButton
                    android:id="@+id/btnSavePreset"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_round_button_small"
                    android:src="@drawable/ic_check"
                    android:contentDescription="Save preset"
                    app:backgroundTint="#7358C4"
                    app:tint="#FFFFFF" />

                <!-- STEP 편집/정렬 -->
                <ImageButton
                    android:id="@+id/btnEditSteps"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_round_button_small"
                    android:src="@drawable/ic_build"
                    android:contentDescription="Edit steps"
                    app:backgroundTint="#7358C4"
                    app:tint="#FFFFFF" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
