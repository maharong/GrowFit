<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- 스킨 프리뷰 이미지 -->
    <ImageView
        android:id="@+id/imgSkinPreview"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerInside"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/plant_default_lv1" />

    <!-- 스킨 이름 -->
    <TextView
        android:id="@+id/txtSkinName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="기본 스킨"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textColor="#2B3A30"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgSkinPreview"
        app:layout_constraintEnd_toStartOf="@id/btnSkinAction" />

    <!-- 가격/상태 -->
    <TextView
        android:id="@+id/txtSkinPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="100 P"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:textColor="#2B3A30"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtSkinName"
        app:layout_constraintStart_toStartOf="@id/txtSkinName"
        app:layout_constraintEnd_toStartOf="@id/btnSkinAction"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- 액션 버튼 -->
    <Button
        android:id="@+id/btnSkinAction"
        android:layout_width="96dp"
        android:layout_height="40dp"
        android:text="구매"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_btn_preset"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
