<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F1F1F">

    <androidx.cardview.widget.CardView
        android:id="@+id/deviceFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:backgroundTint="#F4E4C6"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GROWFIT"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="#333333"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <androidx.cardview.widget.CardView
                android:id="@+id/lcdScreen"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:backgroundTint="#D0E8D2"
                app:cardCornerRadius="18dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintTop_toBottomOf="@id/txtLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/bottomButtonRow">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txtTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STEP EDIT"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- NAME -->
                    <TextView
                        android:id="@+id/textStepNameLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NAME"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/txtTitle"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <EditText
                        android:id="@+id/editStepName"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:autofillHints=""
                        android:background="@android:color/transparent"
                        android:fontFamily="monospace"
                        android:inputType="text"
                        android:textColor="#2B3A30"
                        android:textColorHint="#6C8C78"
                        android:hint="Enter step name"
                        android:padding="4dp"
                        android:singleLine="true"
                        app:layout_constraintTop_toBottomOf="@id/textStepNameLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- TYPE -->
                    <TextView
                        android:id="@+id/textStepTypeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TYPE"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/editStepName"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <Spinner
                        android:id="@+id/spinnerStepType"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:background="@android:color/transparent"
                        app:layout_constraintTop_toBottomOf="@id/textStepTypeLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- WALK/RUN 모드 선택 -->
                    <RadioGroup
                        android:id="@+id/groupWalkRunMode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/spinnerStepType"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                        <RadioButton
                            android:id="@+id/radioModeTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TIME"
                            android:checked="true"/>

                        <RadioButton
                            android:id="@+id/radioModeSteps"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="STEPS"/>
                    </RadioGroup>

                    <!-- DURATION -->
                    <TextView
                        android:id="@+id/textDurationLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DURATION (sec)"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/groupWalkRunMode"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <EditText
                        android:id="@+id/editDurationSec"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:autofillHints=""
                        android:background="@android:color/transparent"
                        android:inputType="number"
                        android:hint="ex) 30"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        android:textColorHint="#6C8C78"
                        android:singleLine="true"
                        app:layout_constraintTop_toBottomOf="@id/textDurationLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- COUNT -->
                    <TextView
                        android:id="@+id/textCountLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COUNT (reps)"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/editDurationSec"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <EditText
                        android:id="@+id/editCount"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:autofillHints=""
                        android:background="@android:color/transparent"
                        android:inputType="number"
                        android:hint="ex) 15"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        android:textColorHint="#6C8C78"
                        android:singleLine="true"
                        app:layout_constraintTop_toBottomOf="@id/textCountLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- STEP GOAL -->
                    <TextView
                        android:id="@+id/textStepGoalLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STEP GOAL"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        android:layout_marginTop="12dp"
                        app:layout_constraintTop_toBottomOf="@id/editCount"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <EditText
                        android:id="@+id/editStepGoal"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="4dp"
                        android:autofillHints="" android:background="@android:color/transparent"
                        android:inputType="number"
                        android:hint="ex) 1000"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        android:textColorHint="#6C8C78"
                        android:singleLine="true"
                        app:layout_constraintTop_toBottomOf="@id/textStepGoalLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- 하단 버튼 -->
            <LinearLayout
                android:id="@+id/bottomButtonRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageButton
                    android:id="@+id/btnSaveStep"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_round_button_small"
                    android:src="@drawable/ic_check"
                    android:contentDescription="Save step"
                    app:backgroundTint="#7358C4"
                    app:tint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnCancelStep"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_round_button_small"
                    android:src="@drawable/ic_close"
                    android:contentDescription="Cancel step edit"
                    app:backgroundTint="#7358C4"
                    app:tint="#FFFFFF" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
