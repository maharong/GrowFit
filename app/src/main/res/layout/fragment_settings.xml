<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F1F1F">

    <!-- 게임기 본체 프레임 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/settingsFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:backgroundTint="#F4E4C6"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- 상단 타이틀 -->
            <TextView
                android:id="@+id/txtSettingsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SETTINGS"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="#333333"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- LCD 영역 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/lcdScreenSettings"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:backgroundTint="#D0E8D2"
                app:cardCornerRadius="18dp"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/txtSettingsTitle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 전체 진동 -->
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchVibrateOverall"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="진동 사용"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:textColor="#2B3A30"
                            android:paddingVertical="8dp"/>

                        <View android:layout_width="match_parent" android:layout_height="8dp"/>

                        <!-- 마지막 N초 전 진동 -->
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchVibrateLastSeconds"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="마지막 N초 전 진동"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:textColor="#2B3A30"
                            android:paddingVertical="8dp"/>

                        <!-- N 입력 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="16dp"
                            android:paddingTop="4dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="N(초)"
                                android:textSize="13sp"
                                android:fontFamily="monospace"
                                android:textColor="#555555"/>

                            <EditText
                                android:id="@+id/editLastSeconds"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:ems="3"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:textSize="14sp"
                                android:fontFamily="monospace"
                                android:background="@android:color/transparent"
                                android:padding="4dp"
                                android:textColor="#2B3A30"/>
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="16dp"/>

                        <!-- 다음 스텝 -->
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchVibrateStepChange"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="다음 스텝 넘어갈 때 진동"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:textColor="#2B3A30"
                            android:paddingVertical="8dp"/>

                        <!-- 프리셋 완료 -->
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/switchVibratePresetComplete"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="프리셋 완료 시 진동"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:textColor="#2B3A30"
                            android:paddingVertical="8dp"/>

                    </LinearLayout>
                </ScrollView>
            </androidx.cardview.widget.CardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
