<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1F1F1F">

    <!-- 레트로 게임기 전체 프레임 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/deviceFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:backgroundTint="#F4E4C6"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <!-- 상단 로고 -->
            <TextView
                android:id="@+id/txtLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GROWFIT"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="#333333"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- 설정 버튼 (SET 버튼 포지션) -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_round_button_small"
                android:contentDescription="Settings"
                android:src="@drawable/ic_settings"
                app:layout_constraintBottom_toBottomOf="@id/txtLogo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#FFFFFF" />

            <!-- LCD 영역 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/lcdScreen"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:backgroundTint="#D0E8D2"
                app:cardCornerRadius="18dp"
                app:layout_constraintTop_toBottomOf="@id/txtLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/btnShop"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/txtPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="123 P"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <ImageView
                        android:id="@+id/imgPlant"
                        android:layout_width="260dp"
                        android:layout_height="260dp"
                        android:src="@drawable/plant_default_lv1"
                        android:contentDescription="Plant"
                        app:layout_constraintTop_toBottomOf="@id/txtPoints"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="4dp" />

                    <TextView
                        android:id="@+id/txtLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LV 1"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/imgPlant"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/txtExpValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45 / 100 EXP"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@id/expProgress"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <ProgressBar
                        android:id="@+id/expProgress"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="0dp"
                        android:layout_height="16dp"
                        android:progress="45"
                        android:max="100"
                        android:progressDrawable="@drawable/exp_progress_bar_retro"
                        app:layout_constraintTop_toBottomOf="@id/txtLevel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:id="@+id/txtPresetStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="PRESET: -\nTODAY: READY"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp"
                        android:gravity="start"
                        android:fontFamily="monospace"
                        android:textColor="#2B3A30"
                        android:layout_marginTop="30dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintTop_toBottomOf="@id/expProgress"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnShop"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="SHOP"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_btn_preset"
                android:layout_marginBottom="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/buttonRow" />

            <!-- 아래 버튼 두 개 -->
            <LinearLayout
                android:id="@+id/buttonRow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <Button
                    android:id="@+id/btnPreset"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="PRESET"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_preset"/>

                <Button
                    android:id="@+id/btnStart"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="START"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_start"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
